{
  "info": {
    "name": "Operation Borderless API",
    "description": "Generated from openapi.json by `yarn openapi:export`. Run \"Create a wallet\" first: it saves wallet_id; the transfer needs \"Create a second wallet\" as well.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "wallet_id",
      "value": ""
    },
    {
      "key": "wallet_id_b",
      "value": ""
    },
    {
      "key": "transaction_id",
      "value": ""
    },
    {
      "key": "quote_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "wallets",
      "item": [
        {
          "name": "Create a wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"phone\": \"08031234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs an email, a phone number or both. Creates one zero-balance account per supported coin. Email and phone are unique (email case-insensitively)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('wallet_id', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a second wallet (transfer recipient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"recipient@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs an email, a phone number or both. Creates one zero-balance account per supported coin. Email and phone are unique (email case-insensitively)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('wallet_id_b', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a wallet",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/wallets/{{wallet_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallets",
                "{{wallet_id}}"
              ]
            },
            "description": "Balances per coin plus an indicative USD total from the current rates."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "deposits",
      "item": [
        {
          "name": "Simulated deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/wallets/{{wallet_id}}/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallets",
                "{{wallet_id}}",
                "deposits"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"cNGN\",\n  \"amount\": \"1000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Credits the wallet from the external account. Sandbox only: nothing real moves. Never touches FX."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('transaction_id', body.transaction.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "swaps",
      "item": [
        {
          "name": "Swap one coin for another inside a wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/wallets/{{wallet_id}}/swaps",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallets",
                "{{wallet_id}}",
                "swaps"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_currency\": \"cNGN\",\n  \"to_currency\": \"USDx\",\n  \"amount\": \"1500\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Converts at the current rate (or at the rate of quote_id), flooring the destination to 6 decimals. The rate, its source and its time are recorded on the transaction."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('transaction_id', body.transaction.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "transfers",
      "item": [
        {
          "name": "Send coins to another wallet, converting when the currencies differ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/wallets/{{wallet_id}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallets",
                "{{wallet_id}}",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to_wallet_id\": \"{{wallet_id_b}}\",\n  \"source_currency\": \"cNGN\",\n  \"destination_currency\": \"cGHS\",\n  \"amount\": \"1500\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same-currency transfers never read an FX rate and keep working during an FX outage. Cross-currency transfers convert like a swap. balances_after is the sender."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('transaction_id', body.transaction.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "fx",
      "item": [
        {
          "name": "Current rate matrix",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/fx/rates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "fx",
                "rates"
              ]
            },
            "description": "All 20 ordered pairs, as exact 12-decimal rates. The rates are simulated: see provider and source."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lock the current rate for a short time",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/fx/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "fx",
                "quotes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": \"{{wallet_id}}\",\n  \"from_currency\": \"cNGN\",\n  \"to_currency\": \"USDx\",\n  \"amount\": \"1500\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Pass the returned quote_id to a swap or a cross-currency transfer from the same wallet, for the same pair and amount. A quote works once and expires after FX_QUOTE_TTL_MS (default 30 seconds)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('quote_id', body.quote_id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "transactions",
      "item": [
        {
          "name": "Wallet history, newest first",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/wallets/{{wallet_id}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallets",
                "{{wallet_id}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "currency",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Keyset pagination: pass next_cursor back as cursor. Optional filters: type, currency (either side)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transaction detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions/{{transaction_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "transactions",
                "{{transaction_id}}"
              ]
            },
            "description": "Includes the signed ledger entries; they sum to zero per currency."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "admin",
      "item": [
        {
          "name": "Run a reconciliation now (detects drift, never repairs it)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/reconciliation/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "reconciliation",
                "run"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "ADMIN endpoint. Unauthenticated in this sandbox: anyone who can reach the API can call it. Returns { \"skipped\": true } when another run is in progress."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Latest reconciliation run",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/reconciliation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "reconciliation"
              ]
            },
            "description": "ADMIN endpoint. Unauthenticated in this sandbox: anyone who can reach the API can call it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
