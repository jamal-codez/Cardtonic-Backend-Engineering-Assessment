    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --require ts-node/register/transpile-only src/main.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "yarn test:unit && yarn test:int",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects int --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --require ts-node/register/transpile-only src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --require ts-node/register/transpile-only src/db/seed.ts",
    "openapi:export": "node --require ts-node/register/transpile-only scripts/export-openapi.ts",
    "demo": "node --require ts-node/register/transpile-only scripts/demo.ts",
    "load": "node --require ts-node/register/transpile-only scripts/load.ts",
    "reconcile": "node --env-file-if-exists=.env --require ts-node/register/transpile-only src/ledger/reconcile-cli.ts"
  }
}
